# Secrets
.env
serviceAccountKey.json
*.key
*.pem

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# ML Models (large — use external storage or Git LFS)
ml-service/models/*.h5
ml-service/models/*.pt
ml-service/models/*.pkl
ml-service/models/*.joblib
# To force-track a specific model: git add -f ml-service/models/classifier.pkl

# Jupyter checkpoints
notebooks/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Dataset images (large — store externally, only commit CSVs)
dataset/genuine/
dataset/tampered/
dataset/indian/
dataset/test_bills/
!dataset/genuine/.gitkeep
!dataset/tampered/.gitkeep
!dataset/indian/.gitkeep
!dataset/test_bills/.gitkeep
!dataset/processed/*.csv

# Raw images
*.jpg
*.jpeg
*.png

# Exception: generated report figures are deliverables, not dataset images.
# Regenerated by ml-service/make_report_figures.py — small, and the .md
# reports link to them directly.
!report/assets/*.png
*.gif
*.bmp
*.tiff
*.webp

# OS
.DS_Store
Thumbs.db

# Uploads / temp
uploads/
tmp/
temp/
*.tmp

# IDE
.vscode/settings.json

# Git hooks (local only)
.githooks/
.idea/

# Local AI assistant context — never commit
CLAUDE.md

# Real user data exported from Firestore — regenerate via backend/export_firestore.js
dataset/processed/firestore_receipts.csv

# Backups written by dataset/rasterize_pdfs.py
*.csv.bak

# Forensic feature cache — regenerates in ~17s from train_fraud_forensics.py
report/assets/forensic_features*.csv

# Pristine backup written by dataset/repair_master_schema.py — git history is the real backup
*.csv.orig
