# Environment variables for the Bill Scanning Based Reward & Intelligence System.
# Copy the relevant block into a local .env, or paste the values into the host's
# environment settings when deploying. Never commit a filled-in copy.

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND  (backend/server.js)
# ─────────────────────────────────────────────────────────────────────────────

# Port to listen on. Cloud hosts inject this automatically — do not set it there.
PORT=3000

# Where the Python ML service lives. Must have NO trailing slash.
# Local:  http://localhost:5001
# Cloud:  the deployed ML service URL, e.g. https://araj-ml.onrender.com
ML_SERVICE_URL=http://localhost:5001

# Signing secret for auth tokens. Use a long random string, and a DIFFERENT one
# in each environment — never reuse the local dev secret in a deployed service.
JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin credentials.
#
# IMPORTANT — how server.js resolves these (see initializeFirebaseAdmin):
#   1. If GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_CONFIG is set, it calls
#      admin.initializeApp() and lets the SDK resolve credentials itself.
#   2. Otherwise it loads ./backend/serviceAccountKey.json from disk, and exits
#      if that file is missing.
#
# GOOGLE_APPLICATION_CREDENTIALS must be a PATH TO A FILE, not JSON content.
# FIREBASE_CONFIG supplies project config (projectId, databaseURL) and does NOT
# supply credentials — setting it alone will make the SDK skip the file check
# and then fail to authenticate against Firestore.
#
# Local:  leave both unset and keep serviceAccountKey.json in backend/
# Render: upload serviceAccountKey.json as a Secret File, then point this at the
#         path Render mounts it at.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json

# ─────────────────────────────────────────────────────────────────────────────
# ML SERVICE  (ml-service/app.py)
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini key used by the OCR pipeline. Free tier is 5 requests/minute,
# and ocr.py enforces a 23-second gap between calls to stay inside it.
# One key per project. Separate projects have separate quotas, so rotating
# across them multiplies the free-tier ceiling.
GEMINI_API_KEY_1=your-gemini-api-key
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...

# Which of the above are on a billed plan. Paid keys skip the 23-second
# free-tier spacing and are tried first.
# GEMINI_PAID_KEYS=GEMINI_API_KEY_1

# Port for local runs only. app.py reads ML_PORT, but a cloud host supplies PORT
# instead — that is why the production start command is gunicorn with an
# explicit --bind 0.0.0.0:$PORT rather than `python app.py`.
ML_PORT=5001

# Where fetch_models.py pulls the trained binaries from. Defaults to the
# v1.0-fyp GitHub release assets; override to use any other static host.
# MODEL_BASE_URL=https://example.com/models

# Set to 1 to skip the model download (local dev, where models already exist).
# SKIP_MODEL_FETCH=1
